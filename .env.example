# =============================================================================
# APEX-Core Environment Configuration Template
# =============================================================================

# MySQL 8.0 Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/apex_core_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=apex_admin
SPRING_DATASOURCE_PASSWORD=secure_dev_password

# Redis Distributed Cache & Lock
REDIS_HOST=localhost
REDIS_PORT=6379

# Redpanda / Apache Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security & JWT Token Signing
APEX_SECURITY_JWT_SECRET=apex-core-super-secure-enterprise-jwt-token-secret-key-32bytes-minimum

# Gateway Downstream Service Routing
HRIS_SERVICE_URL=http://localhost:8081
PROCUREMENT_SERVICE_URL=http://localhost:8082
FINANCE_SERVICE_URL=http://localhost:8083
